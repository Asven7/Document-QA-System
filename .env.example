# ============================================================================
# Document QA System - environment configuration template
#
# Copy this file to ".env" and adjust the values:
#     cp .env.example .env
#
# NEVER commit the real ".env" file or paste real API keys into it.
# Only ".env.example" (with placeholders) belongs in version control.
# ============================================================================

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Generate a strong key, e.g.:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-50-character-random-string
DJANGO_DEBUG=False
# Comma-separated list of hosts the app is served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the Admin is reached through a proxy (optional).
# CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ---------------------------------------------------------------------------
# Database (PostgreSQL service from docker-compose.yml)
# ---------------------------------------------------------------------------
DJANGO_DB=postgres
POSTGRES_DB=documentqa
POSTGRES_USER=documentqa
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# LLM (OpenRouter) - https://openrouter.ai/
# ---------------------------------------------------------------------------
# Create a free account, then create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# A free model; browse https://openrouter.ai/collections/free-models for alternatives.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Embeddings (local, no API key) and vector store
# ---------------------------------------------------------------------------
# Provider: "fastembed" (production, multilingual ONNX model) or "fake"
# (deterministic offline embeddings for tests/demos).
EMBEDDINGS_PROVIDER=fastembed
# Multilingual model with strong Persian support.
# Alternatives: intfloat/multilingual-e5-large,
#               sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B-Q
# Where the ONNX embedding model is cached after its first download (~1.1 GB,
# downloaded ONCE by the embedding-init Compose service before the web
# container starts). Inside Docker Compose this path is a named volume
# (model_cache), so the download happens only once and survives restarts and
# container recreation. On very slow networks you can set
# HF_ENDPOINT=https://hf-mirror.com to fetch the model from a mirror.
FASTEMBED_CACHE_PATH=model_cache
# Local-cache mode for the web container: after embedding-init has verified
# the model, the web app must never download model files (HF_HUB_OFFLINE=1).
# Set to 0 only for debugging, to let the web container fetch the model
# itself (not recommended; use the embedding-init service instead).
EMBEDDING_OFFLINE=1
# Load and verify the embedding model in every Gunicorn worker BEFORE it
# serves requests (see gunicorn.conf.py). Each worker then holds the model
# in RAM (~1 GB each with the default model); with WEB_WORKERS=2 plan for
# ~3 GB RAM total. Set to 0 to fall back to lazy first-use loading.
EMBEDDING_WARMUP_ON_START=1
# Persistence path for the Chroma vector database (volume-mounted in Docker).
CHROMA_PERSIST_DIRECTORY=chroma_data

# ---------------------------------------------------------------------------
# Document processing
# ---------------------------------------------------------------------------
# Maximum accepted upload size in megabytes.
UPLOAD_MAX_FILE_SIZE_MB=10
# Chunk size in characters and overlap between consecutive chunks.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# Retrieval pipeline
# ---------------------------------------------------------------------------
# "hybrid" = semantic + BM25 lexical search fused with Reciprocal Rank Fusion
# "semantic" = semantic channel only
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RETRIEVAL_RRF_K=60
RETRIEVAL_MIN_SCORE=0.0
RETRIEVAL_USE_MMR=False

# ---------------------------------------------------------------------------
# REST API
# ---------------------------------------------------------------------------
API_PAGE_SIZE=20

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# Hard cap for manually entered document text (characters)
DOCUMENT_MAX_TEXT_CHARS=500000

# ---------------------------------------------------------------------------
# Document processing / background workers
# ---------------------------------------------------------------------------
# Run chunking+embedding outside the HTTP request (recommended in Docker).
# Set to False only for debugging or the test suite.
DOCUMENT_PROCESSING_ASYNC=True
# Gunicorn worker processes. Each worker may load the embedding model
# lazily (~1 GB RAM); use 1 on memory-constrained machines.
WEB_WORKERS=2
